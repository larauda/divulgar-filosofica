---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Agenda Filosófica | Divulgar Filosófica',
  description:
    'Conoce los próximos encuentros, talleres, conversatorios y actividades filosóficas de Divulgar Filosófica.',
};

const agendaEntries = await getCollection('agenda');

const today = new Date();
today.setHours(0, 0, 0, 0);

const normalizeDate = (date?: Date) => {
  if (!date) return undefined;

  const normalizedDate = new Date(date);
  normalizedDate.setHours(0, 0, 0, 0);

  return normalizedDate;
};

const getAgendaUrl = (id: string) => {
  const slug = id.replace(/\.(md|mdx)$/, '');

  return `/agenda/${slug}`;
};

const isFutureEvent = (date?: Date) => {
  const eventDate = normalizeDate(date);

  return eventDate ? eventDate >= today : false;
};

const isPastEvent = (date?: Date) => {
  const eventDate = normalizeDate(date);

  return eventDate ? eventDate < today : false;
};

const formatDateParts = (date?: Date) => {
  if (!date) {
    return {
      day: '—',
      month: 'SIN FECHA',
      year: '',
    };
  }

  return {
    day: new Intl.DateTimeFormat('es-CL', {
      day: '2-digit',
    }).format(date),

    month: new Intl.DateTimeFormat('es-CL', {
      month: 'short',
    })
      .format(date)
      .replace('.', '')
      .toUpperCase(),

    year: new Intl.DateTimeFormat('es-CL', {
      year: 'numeric',
    }).format(date),
  };
};

const formatLongDate = (date?: Date) => {
  if (!date) return '';

  return new Intl.DateTimeFormat('es-CL', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const formatTime = (time?: string) => {
  if (!time) return '';

  return time.toLowerCase().includes('hrs')
    ? time
    : `${time} hrs`;
};

const hasValidRegistrationUrl = (registrationUrl?: string) => {
  return (
    typeof registrationUrl === 'string' &&
    registrationUrl.trim() !== '' &&
    registrationUrl.trim() !== '#'
  );
};

const getTypeClass = (type?: string) => {
  const normalizedType = type?.toLowerCase().trim() ?? '';

  if (normalizedType.includes('taller')) {
    return 'agenda-type--taller';
  }

  if (
    normalizedType.includes('charla') ||
    normalizedType.includes('conversatorio')
  ) {
    return 'agenda-type--conversacion';
  }

  if (
    normalizedType.includes('curso') ||
    normalizedType.includes('seminario')
  ) {
    return 'agenda-type--formacion';
  }

  if (
    normalizedType.includes('encuentro') ||
    normalizedType.includes('jornada')
  ) {
    return 'agenda-type--encuentro';
  }

  return 'agenda-type--general';
};

const upcomingEvents = agendaEntries
  .filter((entry) => isFutureEvent(entry.data.date))
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;

    const dateA = a.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER;
    const dateB = b.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER;

    return dateA - dateB;
  });

const pastEvents = agendaEntries
  .filter((entry) => isPastEvent(entry.data.date))
  .sort((a, b) => {
    const dateA = a.data.date?.getTime() ?? 0;
    const dateB = b.data.date?.getTime() ?? 0;

    return dateB - dateA;
  });

const eventsWithoutDate = agendaEntries.filter(
  (entry) => !entry.data.date
);
---

<Layout metadata={metadata}>
  <main class="agenda-page">

    <!-- Portada -->
    <section class="agenda-hero">
      <div class="agenda-decoration" aria-hidden="true">
        <span class="agenda-decoration__circle agenda-decoration__circle--one"></span>
        <span class="agenda-decoration__circle agenda-decoration__circle--two"></span>
        <span class="agenda-decoration__dot"></span>
      </div>

      <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-4xl text-center">
          <p class="agenda-label mb-5 uppercase tracking-[0.22em] text-[#79558c]">
            Divulgar Filosófica
          </p>

          <h1 class="agenda-page-title leading-tight text-[#214536]">
            Agenda Filosófica
          </h1>

          <p class="agenda-intro mx-auto mt-7 max-w-2xl leading-relaxed text-[#4f5f58]">
            Un espacio para descubrir encuentros, talleres, conversaciones y
            experiencias que nos invitan a pensar en comunidad.
          </p>

          <div class="mt-9 flex flex-wrap justify-center gap-3">
            {
              upcomingEvents.length > 0 && (
                <a
                  href="#proximos-eventos"
                  class="agenda-navigation-button agenda-navigation-button--primary"
                >
                  Próximos eventos
                </a>
              )
            }

            {
              pastEvents.length > 0 && (
                <a
                  href="#archivo-agenda"
                  class="agenda-navigation-button"
                >
                  Revisar archivo
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {
      agendaEntries.length > 0 ? (
        <>
          {
            upcomingEvents.length > 0 ? (
              <section
                id="proximos-eventos"
                class="agenda-section bg-[#f8f5f0] py-20 sm:py-24"
              >
                <div class="mx-auto max-w-7xl px-6 lg:px-8">
                  <div class="agenda-section-header">
                    <div>
                      <p class="agenda-label mb-3 uppercase tracking-[0.22em] text-[#79558c]">
                        Próximamente
                      </p>

                      <h2 class="agenda-section-title text-[#214536]">
                        Encuentros para seguir pensando
                      </h2>
                    </div>

                    <p class="max-w-xl leading-relaxed text-[#58645f]">
                      Consulta las próximas fechas, modalidades y lugares de
                      encuentro. Algunas actividades requieren inscripción
                      previa.
                    </p>
                  </div>

                  <div class="agenda-list">
                    {
                      upcomingEvents.map((entry) => {
                        const eventUrl = getAgendaUrl(entry.id);
                        const dateParts = formatDateParts(entry.data.date);

                        const canRegister = hasValidRegistrationUrl(
                          entry.data.registrationUrl
                        );

                        return (
                          <article
                            class:list={[
                              'agenda-event',
                              {
                                'agenda-event--featured': entry.data.featured,
                              },
                            ]}
                          >
                            {
                              entry.data.featured && (
                                <div class="agenda-featured-ribbon">
                                  <span aria-hidden="true">✦</span>
                                  Recomendación de la semana
                                </div>
                              )
                            }

                            <div class="agenda-event__date">
                              <span class="agenda-event__day">
                                {dateParts.day}
                              </span>

                              <span class="agenda-event__month">
                                {dateParts.month}
                              </span>

                              <span class="agenda-event__year">
                                {dateParts.year}
                              </span>
                            </div>

                            <div class="agenda-event__content">
                              <div class="mb-4 flex flex-wrap items-center gap-3">
                                {
                                  entry.data.type && (
                                    <span
                                      class:list={[
                                        'agenda-type',
                                        getTypeClass(entry.data.type),
                                      ]}
                                    >
                                      <span
                                        class="agenda-type__indicator"
                                        aria-hidden="true"
                                      ></span>

                                      {entry.data.type}
                                    </span>
                                  )
                                }

                                {
                                  entry.data.status && (
                                    <span class="agenda-status">
                                      {entry.data.status}
                                    </span>
                                  )
                                }
                              </div>

                              <h3 class="agenda-event__title">
                                <a href={eventUrl}>
                                  {entry.data.title}
                                </a>
                              </h3>

                              {
                                entry.data.excerpt && (
                                  <p class="agenda-event__excerpt">
                                    {entry.data.excerpt}
                                  </p>
                                )
                              }

                              <div class="agenda-event__information">
                                {
                                  entry.data.organizer && (
                                    <p>
                                      <strong>Organiza:</strong>{' '}
                                      {entry.data.organizer}
                                    </p>
                                  )
                                }

                                {
                                  entry.data.date && (
                                    <p>
                                      <strong>Fecha:</strong>{' '}
                                      <span class="capitalize">
                                        {formatLongDate(entry.data.date)}
                                      </span>
                                    </p>
                                  )
                                }

                                {
                                  entry.data.time && (
                                    <p>
                                      <strong>Horario:</strong>{' '}
                                      {formatTime(entry.data.time)}
                                    </p>
                                  )
                                }

                                {
                                  entry.data.modality && (
                                    <p>
                                      <strong>Modalidad:</strong>{' '}
                                      {entry.data.modality}
                                    </p>
                                  )
                                }

                                {
                                  entry.data.location && (
                                    <p>
                                      <strong>Lugar:</strong>{' '}
                                      {entry.data.location}
                                    </p>
                                  )
                                }
                              </div>

                              <div class="agenda-event__actions">
                                {
                                  canRegister && (
                                    <a
                                      href={entry.data.registrationUrl}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="agenda-button agenda-button--primary"
                                    >
                                      Inscribirse
                                    </a>
                                  )
                                }

                                <a
                                  href={eventUrl}
                                  class="agenda-button agenda-button--secondary"
                                >
                                  Ver evento
                                  <span aria-hidden="true">→</span>
                                </a>
                              </div>
                            </div>

                            {
                              entry.data.image && (
                                <a
                                  href={eventUrl}
                                  class="agenda-event__image"
                                  aria-label={`Ver evento: ${entry.data.title}`}
                                >
                                  <img
                                    src={entry.data.image}
                                    alt={entry.data.title}
                                    loading="lazy"
                                  />
                                </a>
                              )
                            }
                          </article>
                        );
                      })
                    }
                  </div>
                </div>
              </section>
            ) : (
              <section class="agenda-section bg-[#f8f5f0] py-20 sm:py-24">
                <div class="mx-auto max-w-4xl px-6 lg:px-8">
                  <div class="agenda-empty">
                    <p class="agenda-label mb-4 uppercase tracking-[0.22em] text-[#79558c]">
                      Próximamente
                    </p>

                    <h2 class="agenda-empty__title text-[#214536]">
                      Estamos preparando nuevos encuentros.
                    </h2>

                    <p class="agenda-intro mx-auto mt-5 max-w-xl text-[#58645f]">
                      Muy pronto publicaremos nuevas actividades para seguir
                      compartiendo preguntas, ideas y experiencias.
                    </p>
                  </div>
                </div>
              </section>
            )
          }

          {
            eventsWithoutDate.length > 0 && (
              <section class="agenda-section bg-white py-20 sm:py-24">
                <div class="mx-auto max-w-7xl px-6 lg:px-8">
                  <div class="agenda-section-header">
                    <div>
                      <p class="agenda-label mb-3 uppercase tracking-[0.22em] text-[#79558c]">
                        En preparación
                      </p>

                      <h2 class="agenda-section-title text-[#214536]">
                        Próximas propuestas
                      </h2>
                    </div>

                    <p class="max-w-xl leading-relaxed text-[#58645f]">
                      Actividades que ya forman parte de nuestra programación y
                      cuya fecha será anunciada próximamente.
                    </p>
                  </div>

                  <div class="agenda-list">
                    {
                      eventsWithoutDate.map((entry) => {
                        const eventUrl = getAgendaUrl(entry.id);
                        const dateParts = formatDateParts();

                        return (
                          <article class="agenda-event agenda-event--undated">
                            <div class="agenda-event__date">
                              <span class="agenda-event__day">
                                {dateParts.day}
                              </span>

                              <span class="agenda-event__month">
                                {dateParts.month}
                              </span>
                            </div>

                            <div class="agenda-event__content">
                              <div class="mb-4 flex flex-wrap items-center gap-3">
                                {
                                  entry.data.type && (
                                    <span
                                      class:list={[
                                        'agenda-type',
                                        getTypeClass(entry.data.type),
                                      ]}
                                    >
                                      <span
                                        class="agenda-type__indicator"
                                        aria-hidden="true"
                                      ></span>

                                      {entry.data.type}
                                    </span>
                                  )
                                }

                                <span class="agenda-status">
                                  {entry.data.status || 'Próximamente'}
                                </span>
                              </div>

                              <h3 class="agenda-event__title">
                                <a href={eventUrl}>
                                  {entry.data.title}
                                </a>
                              </h3>

                              {
                                entry.data.excerpt && (
                                  <p class="agenda-event__excerpt">
                                    {entry.data.excerpt}
                                  </p>
                                )
                              }

                              <div class="agenda-event__actions">
                                <a
                                  href={eventUrl}
                                  class="agenda-button agenda-button--secondary"
                                >
                                  Conocer más
                                  <span aria-hidden="true">→</span>
                                </a>
                              </div>
                            </div>

                            {
                              entry.data.image && (
                                <a
                                  href={eventUrl}
                                  class="agenda-event__image"
                                  aria-label={`Ver evento: ${entry.data.title}`}
                                >
                                  <img
                                    src={entry.data.image}
                                    alt={entry.data.title}
                                    loading="lazy"
                                  />
                                </a>
                              )
                            }
                          </article>
                        );
                      })
                    }
                  </div>
                </div>
              </section>
            )
          }

          {
            pastEvents.length > 0 && (
              <section
                id="archivo-agenda"
                class="agenda-section agenda-archive py-20 sm:py-24"
              >
                <div class="mx-auto max-w-7xl px-6 lg:px-8">
                  <div class="agenda-section-header agenda-section-header--archive">
                    <div>
                      <p class="agenda-label mb-3 uppercase tracking-[0.22em] text-[#c8b1d5]">
                        Archivo
                      </p>

                      <h2 class="agenda-section-title text-white">
                        Encuentros realizados
                      </h2>
                    </div>

                    <p class="max-w-xl leading-relaxed text-white/70">
                      Revisa las actividades que han formado parte de nuestra
                      agenda y vuelve a recorrer sus preguntas y contenidos.
                    </p>
                  </div>

                  <div class="agenda-archive-grid">
                    {
                      pastEvents.map((entry) => {
                        const eventUrl = getAgendaUrl(entry.id);
                        const dateParts = formatDateParts(entry.data.date);

                        return (
                          <article class="agenda-archive-card">
                            {
                              entry.data.image && (
                                <a
                                  href={eventUrl}
                                  class="agenda-archive-card__image"
                                  aria-label={`Ver evento: ${entry.data.title}`}
                                >
                                  <img
                                    src={entry.data.image}
                                    alt={entry.data.title}
                                    loading="lazy"
                                  />

                                  <div class="agenda-archive-card__date">
                                    <strong>{dateParts.day}</strong>
                                    <span>
                                      {dateParts.month} {dateParts.year}
                                    </span>
                                  </div>
                                </a>
                              )
                            }

                            <div class="agenda-archive-card__content">
                              {
                                entry.data.type && (
                                  <span
                                    class:list={[
                                      'agenda-type',
                                      getTypeClass(entry.data.type),
                                    ]}
                                  >
                                    <span
                                      class="agenda-type__indicator"
                                      aria-hidden="true"
                                    ></span>

                                    {entry.data.type}
                                  </span>
                                )
                              }

                              <h3>
                                <a href={eventUrl}>
                                  {entry.data.title}
                                </a>
                              </h3>

                              {
                                entry.data.excerpt && (
                                  <p>{entry.data.excerpt}</p>
                                )
                              }

                              <a
                                href={eventUrl}
                                class="agenda-archive-card__link"
                              >
                                Revisar actividad
                                <span aria-hidden="true">→</span>
                              </a>
                            </div>
                          </article>
                        );
                      })
                    }
                  </div>
                </div>
              </section>
            )
          }
        </>
      ) : (
        <section class="agenda-section bg-[#f8f5f0] py-24">
          <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <div class="agenda-empty">
              <p class="agenda-label mb-4 uppercase tracking-[0.22em] text-[#79558c]">
                Agenda Filosófica
              </p>

              <h2 class="agenda-empty__title text-[#214536]">
                Muy pronto tendremos nuevas fechas.
              </h2>

              <p class="agenda-intro mx-auto mt-5 max-w-xl text-[#58645f]">
                Estamos preparando encuentros, talleres y conversaciones para
                seguir pensando en comunidad.
              </p>

              <a
                href="/"
                class="agenda-button agenda-button--primary mt-8"
              >
                Volver al inicio
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- Cierre -->
    <section class="agenda-closing">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
        <div class="mx-auto max-w-3xl text-center">
          <p class="agenda-label mb-4 uppercase tracking-[0.22em] text-white/60">
            Sigue explorando
          </p>

          <h2 class="agenda-closing__title text-white">
            Cada encuentro abre una nueva pregunta.
          </h2>

          <p class="agenda-intro mx-auto mt-6 max-w-2xl text-white/75">
            Conoce nuestras actividades y descubre otros espacios de diálogo,
            formación y reflexión colectiva.
          </p>

          <a
            href="/actividades"
            class="agenda-closing__button"
          >
            Explorar actividades
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
  }

  .agenda-page,
  .agenda-section,
  .agenda-hero {
    font-family: 'Lato', sans-serif;
  }

  .agenda-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(33, 69, 54, 0.1);
    background:
      radial-gradient(
        circle at 15% 20%,
        rgba(160, 91, 234, 0.14),
        transparent 24rem
      ),
      radial-gradient(
        circle at 88% 75%,
        rgba(33, 69, 54, 0.1),
        transparent 25rem
      ),
      #f8f5f0;
  }

  .agenda-decoration__circle,
  .agenda-decoration__dot {
    position: absolute;
    pointer-events: none;
  }

  .agenda-decoration__circle {
    border: 1px solid rgba(121, 85, 140, 0.2);
    border-radius: 999px;
  }

  .agenda-decoration__circle--one {
    top: 12%;
    left: -5rem;
    width: 14rem;
    height: 14rem;
  }

  .agenda-decoration__circle--two {
    right: 7%;
    bottom: -5rem;
    width: 12rem;
    height: 12rem;
  }

  .agenda-decoration__dot {
    top: 25%;
    right: 18%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    background: #a05bea;
    opacity: 0.6;
  }

  .agenda-label {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .agenda-page-title {
    font-family: 'Satisfy', cursive;
    font-size: clamp(4rem, 9vw, 7.5rem);
    font-weight: 400;
  }

  .agenda-intro {
    font-size: 1.1rem;
  }

  .agenda-section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(33, 69, 54, 0.15);
  }

  .agenda-section-title,
  .agenda-empty__title,
  .agenda-closing__title {
    font-family: 'Satisfy', cursive;
    font-weight: 400;
    line-height: 1.08;
  }

  .agenda-section-title {
    font-size: clamp(2.7rem, 5vw, 4.4rem);
  }

  .agenda-empty__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .agenda-closing__title {
    font-size: clamp(2.8rem, 6vw, 5rem);
  }

  .agenda-navigation-button,
  .agenda-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .agenda-navigation-button {
    border: 1px solid rgba(121, 85, 140, 0.4);
    padding: 0.8rem 1.35rem;
    color: #79558c;
  }

  .agenda-navigation-button:hover {
    border-color: #79558c;
    background: #79558c;
    color: white;
    transform: translateY(-2px);
  }

  .agenda-navigation-button--primary {
    border-color: #79558c;
    background: #79558c;
    color: white;
  }

  .agenda-navigation-button--primary:hover {
    background: #62406f;
  }

  .agenda-list {
    display: grid;
    gap: 1.5rem;
  }

  .agenda-event {
    position: relative;
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) 260px;
    overflow: hidden;
    border: 1px solid rgba(33, 69, 54, 0.1);
    border-radius: 2rem;
    background: white;
    box-shadow: 0 10px 35px rgba(33, 69, 54, 0.05);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .agenda-event:hover {
    border-color: rgba(121, 85, 140, 0.28);
    box-shadow: 0 18px 55px rgba(33, 69, 54, 0.11);
    transform: translateY(-3px);
  }

  .agenda-event--featured {
    border-color: rgba(160, 91, 234, 0.35);
    box-shadow: 0 18px 60px rgba(121, 85, 140, 0.12);
  }

  .agenda-featured-ribbon {
    position: absolute;
    top: 0;
    right: 2rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 0 0 1rem 1rem;
    background: #79558c;
    padding: 0.65rem 1rem;
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .agenda-event__date {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right: 1px solid rgba(33, 69, 54, 0.1);
    background: #214536;
    padding: 2rem 1rem;
    color: white;
    text-align: center;
  }

  .agenda-event__day {
