---
import Layout from '~/layouts/PageLayout.astro';
import KareenImage from '~/assets/images/SoyKarin_02.png';

const metadata = {
  title: 'Sobre Divulgar | Divulgar Filosófica',
  description:
    'Conoce el propósito de Divulgar Filosófica y la trayectoria de Kareén Fredes, filósofa, docente e investigadora.',
};
---

<Layout metadata={metadata}>
  <main class="about-page">

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-container about-hero__grid">

        <div class="about-hero__content">
          <p class="about-eyebrow">
            SOBRE DIVULGAR
          </p>

          <h1 class="about-main-title">
            Filosofía para aprender, encontrarnos y pensar en comunidad.
          </h1>

          <p class="about-lead">
            Divulgar Filosófica es un espacio de formación, encuentro y
            reflexión dedicado a promover la filosofía mediante talleres,
            grupos de estudio y actividades de divulgación.
          </p>
        </div>

        <div class="about-hero__image-wrap">
          <div class="about-hero__circle" aria-hidden="true"></div>

          <img
            src={KareenImage.src}
            alt="Kareén Fredes"
            class="about-hero__image"
          />
        </div>

      </div>
    </section>

    <!-- QUÉ ES DIVULGAR -->
    <section class="about-section about-section--light">
      <div class="about-container about-grid">

        <div>
          <p class="about-number">
            01
          </p>

          <p class="about-eyebrow">
            Divulgar Filosófica
          </p>

          <h2 class="about-title">
            Un espacio de formación, encuentro y reflexión.
          </h2>
        </div>

        <div class="about-copy">
          <p>
            Divulgar Filosófica es un espacio dedicado a promover la filosofía
            mediante talleres, grupos de estudio y actividades de divulgación.
          </p>

          <p>
            Genera instancias de aprendizaje y diálogo en torno al pensamiento
            filosófico, con especial énfasis en la filosofía política y las
            teorías feministas.
          </p>
        </div>

      </div>
    </section>

    <!-- NUESTRA MIRADA -->
    <section class="about-section about-section--green">
      <div class="about-container about-grid">

        <div>
          <p class="about-number about-number--light">
            02
          </p>

          <p class="about-eyebrow about-eyebrow--light">
            Nuestra mirada
          </p>

          <h2 class="about-title about-title--light">
            La filosofía como una necesidad comunitaria.
          </h2>
        </div>

        <div class="about-copy about-copy--light">
          <p>
            Divulgar Filosófica surge de la convicción de que la filosofía
            constituye hoy una necesidad comunitaria y no un conocimiento
            exclusivo reservado a los espacios tradicionales.
          </p>

          <p>
            Desde esta perspectiva, busca contribuir a la democratización del
            conocimiento mediante la creación de espacios seguros y accesibles,
            dirigidos principalmente a mujeres y mujeres transgénero.
          </p>

          <p>
            Su propósito es fortalecer su participación en la vida social,
            política y cultural.
          </p>
        </div>

      </div>
    </section>

    <!-- KAREÉN -->
    <section class="about-section about-section--lavender">
      <div class="about-container founder-grid">

        <div class="founder-image-wrap">
          <img
            src={KareenImage.src}
            alt="Kareén Fredes, filósofa, docente e investigadora"
            class="founder-image"
          />
        </div>

        <div class="founder-content">

          <p class="about-eyebrow">
            DETRÁS DE DIVULGAR
          </p>

          <h2 class="founder-name">
            Kareén Fredes
          </h2>

          <p class="founder-role">
            Filósofa, docente e investigadora.
          </p>

          <div class="about-copy">
            <p>
              Divulgar Filosófica es sostenido por Kareén Fredes, filósofa,
              docente e investigadora.
            </p>

            <p>
              Es licenciada en Filosofía, diplomada en Métodos de Investigación
              y Publicaciones Académicas, y actualmente desarrolla estudios de
              posgrado e investigación en filosofía contemporánea, con énfasis
              en epistemología y género.
            </p>

            <p>
              Además, forma parte del equipo de investigación de Latinas por el
              Clima, donde participa en proyectos vinculados a la justicia
              climática y el ecofeminismo.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- CÓMO TRABAJAMOS -->
    <section class="about-section about-section--light">
      <div class="about-container">

        <div class="about-heading-centered">
          <p class="about-eyebrow">
            CÓMO TRABAJAMOS
          </p>

          <h2 class="about-title about-title--center">
            Aprender, dialogar y construir conocimiento colectivo.
          </h2>
        </div>

        <div class="work-grid">

          <article class="work-card">
            <span class="work-number">01</span>

            <h3>
              Talleres
            </h3>

            <p>
              Instancias formativas puntuales orientadas a introducir o
              profundizar en autoras, autores, corrientes filosóficas y
              problemáticas contemporáneas desde una perspectiva crítica y
              feminista.
            </p>
          </article>

          <article class="work-card">
            <span class="work-number">02</span>

            <h3>
              Grupos de estudio
            </h3>

            <p>
              Espacios de formación continua desarrollados mediante encuentros
              periódicos de lectura, discusión y reflexión colectiva.
            </p>
          </article>

          <article class="work-card">
            <span class="work-number">03</span>

            <h3>
              Divulgación filosófica
            </h3>

            <p>
              Charlas, encuentros y actividades abiertas orientadas a acercar
              la filosofía a la comunidad y visibilizar las contribuciones de
              filósofas en Chile.
            </p>
          </article>

        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="about-cta">
      <div class="about-container about-cta__inner">

        <p class="about-eyebrow about-eyebrow--light">
          CONVERSEMOS
        </p>

        <h2 class="about-cta__title">
          La filosofía también puede habitar tu comunidad.
        </h2>

        <p class="about-cta__text">
          ¿Te interesa realizar una charla, taller, grupo de estudio o
          mediación filosófica en tu comunidad, organización o espacio
          educativo?
        </p>

        <div class="about-cta__actions">

          <a
            href="mailto:divulgar.filosofica@gmail.com?subject=Consulta%20desde%20Divulgar%20Filosófica"
            class="about-button about-button--light"
          >
            Escribir por correo →
          </a>

          <a
            href="https://www.instagram.com/divulgar.filosofica/"
            target="_blank"
            rel="noopener noreferrer"
            class="about-button about-button--outline"
          >
            Instagram
          </a>

        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .about-page {
    font-family: 'Lato', sans-serif;
    color: #214536;
  }

  .about-container {
    width: min(100% - 3rem, 1280px);
    margin-inline: auto;
  }

  /* HERO */

  .about-hero {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgba(160, 91, 234, 0.14),
        transparent 24rem
      ),
      #f8f5f0;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: 4rem;
    align-items: center;
    min-height: 680px;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .about-hero__content {
    max-width: 720px;
  }

  .about-eyebrow {
    margin: 0 0 1.2rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #79558c;
  }

  .about-eyebrow--light {
    color: rgba(255, 255, 255, 0.7);
  }

  .about-main-title {
    margin: 0;
    font-family: 'Satisfy', cursive;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 400;
    line-height: 1.02;
    color: #214536;
  }

  .about-lead {
    max-width: 650px;
    margin: 2rem 0 0;
    font-size: 1.15rem;
    line-height: 1.85;
    color: #58645f;
  }

  .about-hero__image-wrap {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about-hero__circle {
    position: absolute;
    inset: 12% 5% 5%;
    border-radius: 50%;
    background: rgba(160, 91, 234, 0.12);
  }

  .about-hero__image {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 520px;
  }

  /* SECCIONES */

  .about-section {
    padding: 6rem 0;
  }

  .about-section--light {
    background: #ffffff;
  }

  .about-section--green {
    background: #214536;
  }

  .about-section--lavender {
    background: #eee6f1;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 5rem;
    align-items: start;
  }

  .about-number {
    margin: 0 0 1.2rem;
    font-family: 'Satisfy', cursive;
    font-size: 2.8rem;
    color: #79558c;
  }

  .about-number--light {
    color: rgba(255, 255, 255, 0.75);
  }

  .about-title {
    max-width: 560px;
    margin: 0;
    font-family: 'Satisfy', cursive;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1.12;
    color: #214536;
  }

  .about-title--light {
    color: #ffffff;
  }

  .about-title--center {
    margin-inline: auto;
    text-align: center;
  }

  .about-copy {
    max-width: 680px;
    font-size: 1.05rem;
    line-height: 1.9;
    color: #58645f;
  }

  .about-copy p {
    margin: 0;
  }

  .about-copy p + p {
    margin-top: 1.5rem;
  }

  .about-copy--light {
    color: rgba(255, 255, 255, 0.78);
  }

  /* KAREÉN */

  .founder-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: 5rem;
    align-items: center;
  }

  .founder-image-wrap {
    display: flex;
    justify-content: center;
  }

  .founder-image {
    width: 100%;
    max-width: 470px;
    border-radius: 2rem;
  }

  .founder-name {
    margin: 0;
    font-family: 'Satisfy', cursive;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 400;
    color: #214536;
  }

  .founder-role {
    margin: 0.8rem 0 2rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #79558c;
  }

  /* TRABAJO */

  .about-heading-centered {
    max-width: 760px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .work-card {
    border-radius: 2rem;
    background: #f8f5f0;
    padding: 2rem;
  }

  .work-number {
    display: inline-flex;
    margin-bottom: 1.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #79558c;
  }

  .work-card h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    color: #214536;
  }

  .work-card p {
    margin: 1rem 0 0;
    line-height: 1.75;
    color: #58645f;
  }

  /* CTA */

  .about-cta {
    background:
      radial-gradient(
        circle at 90% 20%,
        rgba(160, 91, 234, 0.24),
        transparent 24rem
      ),
      #79558c;
  }

  .about-cta__inner {
    max-width: 850px;
    padding-top: 6rem;
    padding-bottom: 6rem;
    text-align: center;
  }

  .about-cta__title {
    margin: 0;
    font-family: 'Satisfy', cursive;
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.1;
    color: #ffffff;
  }

  .about-cta__text {
    max-width: 680px;
    margin: 1.5rem auto 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .about-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .about-button:hover {
    transform: translateY(-2px);
  }

  .about-button--light {
    background: #ffffff;
    color: #214536;
  }

  .about-button--outline {
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }

  .about-button--outline:hover {
    background: #ffffff;
    color: #79558c;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .about-hero__grid,
    .about-grid,
    .founder-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-hero__grid {
      min-height: auto;
    }

    .about-hero__image-wrap {
      order: -1;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-container {
      width: min(100% - 2rem, 1280px);
    }

    .about-section {
      padding: 4.5rem 0;
    }

    .about-main-title {
      font-size: clamp(2.6rem, 12vw, 3.8rem);
    }

    .about-title {
      font-size: clamp(1.9rem, 9vw, 2.6rem);
    }

    .founder-name {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .about-cta__inner {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
</style>