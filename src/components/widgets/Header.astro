---
import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import Logo from '~/assets/images/logo-divulgar.png';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  links?: Array<Link>;
  isSticky?: boolean;
}

const { links = [], isSticky = true } = Astro.props;

const pathname = new URL(Astro.url).pathname;
const currentPath = `/${trimSlash(pathname)}`;

const isCurrentPage = (href?: string) => {
  if (!href) return false;

  const cleanHref = href.split('#')[0] || '/';

  if (cleanHref === '/') {
    return currentPath === '/' || currentPath === '';
  }

  return cleanHref === currentPath;
};
---

<header
  id="site-header"
  class:list={[
    'site-header top-0 z-40 w-full border-b border-[#214536]/10 bg-[#F8F5F0]/95 backdrop-blur-md',
    { sticky: isSticky },
  ]}
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 md:px-8 md:py-5">

    <!-- Logo -->

    <a
      href={getHomePermalink()}
      class="relative z-50 inline-flex shrink-0 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A05BEA] focus-visible:ring-offset-4"
      aria-label="Ir al inicio de Divulgar Filosófica"
    >
      <img
        src={Logo.src}
        alt="Divulgar Filosófica"
        class="h-12 w-auto md:h-14"
      />
    </a>

    <!-- Navegación de escritorio -->

    <nav
      class="hidden items-center gap-7 text-sm font-bold text-[#214536] lg:flex"
      aria-label="Navegación principal"
    >
      {
        links.map(({ text, href }) => {
          const sectionId = href?.includes('#')
            ? href.split('#')[1]
            : '';

          return (
            <a
              href={href}
              data-nav-link
              data-section={sectionId}
              aria-current={isCurrentPage(href) ? 'page' : undefined}
              class:list={[
                'nav-link group relative rounded-sm py-2 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A05BEA] focus-visible:ring-offset-4',
                {
                  'is-active text-[#A05BEA]': isCurrentPage(href),
                },
              ]}
            >
              <span>{text}</span>

              <span
                class="nav-link__indicator"
                aria-hidden="true"
              ></span>
            </a>
          );
        })
      }
    </nav>

    <!-- CTA de escritorio -->

    <a
      href="/registro"
      class="hidden shrink-0 rounded-full bg-[#A05BEA] px-6 py-2.5 text-sm font-bold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-[#8E4DE8] hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A05BEA] focus-visible:ring-offset-4 lg:inline-flex"
    >
      Inscripciones
    </a>

    <!-- Botón menú móvil -->

    <button
      id="mobile-menu-button"
      type="button"
      class="relative z-50 inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#214536]/15 bg-white/60 text-[#214536] transition hover:border-[#A05BEA]/40 hover:text-[#A05BEA] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A05BEA] focus-visible:ring-offset-4 lg:hidden"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">
        Abrir menú de navegación
      </span>

      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

  </div>

  <!-- Navegación móvil -->

  <div
    id="mobile-menu"
    class="mobile-menu lg:hidden"
    aria-hidden="true"
  >
    <div class="mobile-menu__backdrop" data-close-menu></div>

    <div class="mobile-menu__panel">

      <nav
        class="flex flex-col"
        aria-label="Navegación móvil"
      >
        {
          links.map(({ text, href }, index) => {
            const sectionId = href?.includes('#')
              ? href.split('#')[1]
              : '';

            return (
              <a
                href={href}
                data-mobile-nav-link
                data-nav-link
                data-section={sectionId}
                style={`--link-index: ${index};`}
                class:list={[
                  'mobile-nav-link',
                  {
                    'is-active': isCurrentPage(href),
                  },
                ]}
              >
                <span class="mobile-nav-link__number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <span class="mobile-nav-link__text">
                  {text}
                </span>

                <span
                  class="mobile-nav-link__arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            );
          })
        }
      </nav>

      <div class="mt-8 border-t border-[#214536]/10 pt-7">

        <a
          href="/registro"
          data-mobile-nav-link
          class="inline-flex w-full items-center justify-center rounded-full bg-[#A05BEA] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[#8E4DE8] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A05BEA] focus-visible:ring-offset-4"
        >
          Inscripciones
        </a>

        <p class="mt-5 text-center text-xs leading-5 text-[#214536]/55">
          Filosofía, educación y pensamiento crítico para la comunidad.
        </p>

      </div>

    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const initializeHeader = () => {
      const header = document.querySelector('#site-header');
      const menuButton = document.querySelector('#mobile-menu-button');
      const mobileMenu = document.querySelector('#mobile-menu');

      if (
        !(header instanceof HTMLElement) ||
        !(menuButton instanceof HTMLButtonElement) ||
        !(mobileMenu instanceof HTMLElement)
      ) {
        return;
      }

      const mobileLinks = mobileMenu.querySelectorAll(
        '[data-mobile-nav-link]'
      );

      const navLinks = document.querySelectorAll(
        '[data-nav-link]'
      );

      const sectionLinks = Array.from(navLinks).filter((link) => {
        return (
          link instanceof HTMLAnchorElement &&
          Boolean(link.dataset.section)
        );
      });

      const setMenuState = (open) => {
        mobileMenu.classList.toggle('is-open', open);
        mobileMenu.setAttribute(
          'aria-hidden',
          open ? 'false' : 'true'
        );

        menuButton.setAttribute(
          'aria-expanded',
          open ? 'true' : 'false'
        );

        menuButton.setAttribute(
          'aria-label',
          open ? 'Cerrar menú' : 'Abrir menú'
        );

        document.documentElement.classList.toggle(
          'menu-is-open',
          open
        );
      };

      menuButton.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('is-open');
        setMenuState(!isOpen);
      });

      mobileMenu
        .querySelectorAll('[data-close-menu]')
        .forEach((element) => {
          element.addEventListener('click', () => {
            setMenuState(false);
          });
        });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setMenuState(false);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuState(false);
          menuButton.focus();
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          setMenuState(false);
        }
      });

      const setActiveSection = (sectionId) => {
        navLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;

          const isActive =
            Boolean(sectionId) &&
            link.dataset.section === sectionId;

          link.classList.toggle('is-active', isActive);

          if (isActive) {
            link.setAttribute('aria-current', 'location');
          } else if (link.dataset.section) {
            link.removeAttribute('aria-current');
          }
        });
      };

      const sections = sectionLinks
        .map((link) => {
          if (!(link instanceof HTMLAnchorElement)) return null;

          const id = link.dataset.section;
          const section = id
            ? document.getElementById(id)
            : null;

          return section;
        })
        .filter(Boolean);

      if (sections.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleSections = entries
              .filter((entry) => entry.isIntersecting)
              .sort(
                (a, b) =>
                  Math.abs(a.boundingClientRect.top) -
                  Math.abs(b.boundingClientRect.top)
              );

            const currentSection = visibleSections[0];

            if (
              currentSection &&
              currentSection.target instanceof HTMLElement
            ) {
              setActiveSection(currentSection.target.id);
            }
          },
          {
            rootMargin: '-28% 0px -58% 0px',
            threshold: [0, 0.1, 0.25, 0.5],
          }
        );

        sections.forEach((section) => {
          observer.observe(section);
        });
      }

      const updateHeaderState = () => {
        header.classList.toggle(
          'is-scrolled',
          window.scrollY > 16
        );
      };

      updateHeaderState();

      window.addEventListener(
        'scroll',
        updateHeaderState,
        { passive: true }
      );
    };

    document.addEventListener(
      'astro:page-load',
      initializeHeader
    );

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initializeHeader,
        { once: true }
      );
    } else {
      initializeHeader();
    }
  })();
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
  }

  :global(html.menu-is-open),
  :global(html.menu-is-open body) {
    overflow: hidden;
  }

  .site-header {
    transition:
      background-color 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .site-header.is-scrolled {
    border-color: rgba(33, 69, 54, 0.14);
    background: rgba(248, 245, 240, 0.97);
    box-shadow: 0 12px 40px rgba(33, 69, 54, 0.08);
  }

  /* =========================================================
     NAVEGACIÓN DE ESCRITORIO
  ========================================================== */

  .nav-link {
    color: #214536;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: #a05bea;
  }

  .nav-link__indicator {
    position: absolute;
    right: 50%;
    bottom: -0.15rem;
    left: 50%;
    height: 2px;
    border-radius: 999px;
    background: #a05bea;
    opacity: 0;
    transform: translateY(3px);
    transition:
      right 220ms ease,
      left 220ms ease,
      opacity 220ms ease,
      transform 220ms ease;
  }

  .nav-link:hover .nav-link__indicator,
  .nav-link.is-active .nav-link__indicator {
    right: 0;
    left: 0;
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================================
     ICONO MÓVIL
  ========================================================== */

  .menu-icon {
    position: relative;
    display: flex;
    width: 20px;
    height: 16px;
    flex-direction: column;
    justify-content: space-between;
  }

  .menu-icon span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 220ms ease,
      opacity 180ms ease,
      width 220ms ease;
  }

  #mobile-menu-button[aria-expanded='true']
    .menu-icon span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #mobile-menu-button[aria-expanded='true']
    .menu-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  #mobile-menu-button[aria-expanded='true']
    .menu-icon span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* =========================================================
     MENÚ MÓVIL
  ========================================================== */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(21, 43, 34, 0.35);
    opacity: 0;
    backdrop-filter: blur(4px);
    transition: opacity 250ms ease;
  }

  .mobile-menu.is-open .mobile-menu__backdrop {
    opacity: 1;
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(88vw, 430px);
    height: 100%;
    overflow-y: auto;
    padding: 7.5rem 1.5rem 2rem;
    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(160, 91, 234, 0.13),
        transparent 18rem
      ),
      #f8f5f0;
    box-shadow: -24px 0 70px rgba(33, 69, 54, 0.14);
    transform: translateX(105%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-nav-link {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(33, 69, 54, 0.1);
    color: #214536;
    opacity: 0;
    text-decoration: none;
    transform: translateX(20px);
    transition:
      color 180ms ease,
      opacity 260ms ease,
      transform 260ms ease;
    transition-delay: calc(var(--link-index) * 35ms);
  }

  .mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: #a05bea;
  }

  .mobile-nav-link__number {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: #79558c;
  }

  .mobile-nav-link__text {
    font-family: 'Satisfy', cursive;
    font-size: clamp(1.8rem, 7vw, 2.35rem);
    line-height: 1.1;
  }

  .mobile-nav-link__arrow {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(160, 91, 234, 0.1);
    font-size: 1rem;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .mobile-nav-link:hover .mobile-nav-link__arrow,
  .mobile-nav-link.is-active .mobile-nav-link__arrow {
    background: #a05bea;
    color: white;
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .site-header,
    .nav-link__indicator,
    .menu-icon span,
    .mobile-menu__backdrop,
    .mobile-menu__panel,
    .mobile-nav-link,
    .mobile-nav-link__arrow {
      transition: none;
    }
  }
</style>