---
import HeroImage from '~/assets/images/hero-karin.png';
---

<section
  id="inicio"
  class="bg-[#F8F5F0] py-16 sm:py-20 lg:py-24"
>
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-2 lg:gap-16 lg:px-8"
  >

    <!-- Contenido -->
    <div class="max-w-xl">

      <p
        class="mb-5 text-sm font-bold uppercase tracking-[0.22em] text-[#79558c]"
      >
        Divulgar Filosófica
      </p>

      <h1
        class="text-[#214536]"
        style="
          font-family: 'Satisfy', cursive;
          font-size: clamp(3.8rem, 7vw, 6.8rem);
          font-weight: 400;
          line-height: 0.98;
        "
      >
        Filosofía para pensar, aprender y encontrarnos.
      </h1>

      <div
        class="mt-8 max-w-lg space-y-5 text-[17px] leading-8 text-stone-600"
      >
        <p>
          Divulgar Filosófica es un espacio de formación, encuentro y
          reflexión dedicado a promover la filosofía mediante talleres,
          grupos de estudio y actividades de divulgación.
        </p>

        <p>
          Generamos instancias de aprendizaje y diálogo en torno al
          pensamiento filosófico, con especial énfasis en la filosofía
          política y las teorías feministas.
        </p>
      </div>

      <!-- Botones -->
      <div class="mt-10 flex flex-wrap gap-3">

        <a
          href="/actividades"
          class="inline-flex items-center justify-center rounded-full bg-[#A05BEA] px-7 py-3 text-sm font-bold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-[#8E4DE8] hover:shadow-lg"
        >
          Conoce las actividades →
        </a>

        <a
          href="#nuestra-mirada"
          class="inline-flex items-center justify-center rounded-full border border-[#79558c] px-7 py-3 text-sm font-bold text-[#79558c] transition duration-300 hover:bg-[#79558c] hover:text-white"
        >
          Nuestra mirada
        </a>

      </div>

    </div>

    <!-- Imagen -->
    <div class="flex justify-center lg:justify-end">

      <img
        src={HeroImage.src}
        alt="Divulgar Filosófica"
        class="w-full max-w-2xl"
      />

    </div>

  </div>
</section>